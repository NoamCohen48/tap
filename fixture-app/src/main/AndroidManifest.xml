<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CAMERA only feeds the runtime-permission dialog tests; no camera hardware is needed. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FixtureApplication"
        android:allowBackup="false"
        android:label="Tap Fixture"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ViewListActivity"
            android:exported="true" />
        <activity
            android:name=".AmbiguityActivity"
            android:exported="true" />
        <activity
            android:name=".PermissionActivity"
            android:exported="true" />
        <activity
            android:name=".PortOccupierActivity"
            android:exported="true" />
        <activity
            android:name=".MotionActivity"
            android:exported="true" />
        <!-- Synchronization state comes from the :sync-sdk manifest (authority <applicationId>.tap-sync). -->
        <provider
            android:name=".FixtureFaultProvider"
            android:authorities="io.github.noamcohen48.tap.fixture.fault"
            android:exported="true"
            android:permission="io.github.noamcohen48.tap.permission.SYNCHRONIZATION" />
    </application>
</manifest>
