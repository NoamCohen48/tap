<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/request_camera_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request camera permission" />

    <TextView
        android:id="@+id/permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Permission idle" />

    <Button
        android:id="@+id/request_location_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request location permission" />

    <TextView
        android:id="@+id/location_permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Location idle" />
</LinearLayout>
